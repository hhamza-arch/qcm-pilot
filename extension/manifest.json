{
  "manifest_version": 3,
  "name": "QCM Pilot",
  "version": "1.1.0",
  "description": "AI study assistant for Google Forms practice quizzes: analyzes questions and can tick the suggested answers in one click. It never submits the form.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://docs.google.com/forms/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "action": {
    "default_title": "QCM Pilot",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://docs.google.com/forms/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
